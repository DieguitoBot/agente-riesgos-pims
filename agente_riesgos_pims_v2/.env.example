# Solo servidor. Usa un proyecto Supabase exclusivo para este agente.
# URL de conexión de PostgreSQL, no URL REST ni clave anon de Supabase.
# Copia .env.example a .env y configura valores reales fuera de Git.
PIMS_DATABASE_URL=postgresql://pims_lector:CAMBIAR@HOST:5432/postgres?sslmode=require
PIMS_DATABASE_ADMIN_URL=postgresql://postgres:CAMBIAR@HOST:5432/postgres?sslmode=require
