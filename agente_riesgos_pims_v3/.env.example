# preparar_demo.py genera automáticamente las conexiones locales.
# En una instalación existente conserva su .env y su clúster.
# No rellenar con credenciales de otro agente.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:4b-q4_K_M
OLLAMA_TIMEOUT=900
RAG_EMBED_MODEL=embeddinggemma
PIMS_BUSQUEDA_SEMANTICA=1
# PIMS_DATABASE_URL: rol limitado, base pims_riesgos_experimental
# PIMS_DATABASE_ADMIN_URL: propietario de la misma base, solo mantenimiento
